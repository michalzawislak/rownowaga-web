# Konfiguracja Apache dla hostingu OVH (https://rownowaga-dietetyka.pl).
# Plik trafia do `dist/` razem z resztą `public/` i jest wysyłany do `www/`.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- Przekierowania 301: zawsze https://rownowaga-dietetyka.pl -------------
# OVH kończy TLS przed Apache, więc oprócz %{HTTPS} sprawdzamy port
# i nagłówek X-Forwarded-Proto.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Katalog bez końcowego ukośnika (np. /polityka-prywatnosci): Apache sam
  # dopisałby ukośnik, ale z adresem http:// - czyli dwa przekierowania.
  # Ta reguła jest pierwsza, żeby każde wejście kończyło się jednym 301.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ https://rownowaga-dietetyka.pl%{REQUEST_URI}/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://rownowaga-dietetyka.pl%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^ https://rownowaga-dietetyka.pl%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Typy MIME, których starszy Apache może nie znać ------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .js .xml .txt .webmanifest
</IfModule>

# --- Kompresja ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# --- Cache i nagłówki bezpieczeństwa -----------------------------------------
<IfModule mod_headers.c>
  # Zasoby z `/_astro/` mają hash w nazwie: każda zmiana to nowy plik,
  # więc można je trzymać w cache przeglądarki przez rok.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML i pozostałe pliki o stałych adresach (robots.txt, sitemap, favicony)
  # przeglądarka musi sprawdzać przy każdej wizycie, żeby widzieć nowe wersje.
  <Else>
    Header set Cache-Control "no-cache"
  </Else>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
