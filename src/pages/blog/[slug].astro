---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);
---

<Layout 
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  image={post.data.image}
>
  <article class="py-16 lg:py-24 bg-[var(--color-background)]">
    <div class="container mx-auto px-4 md:px-8 max-w-4xl">
      <div class="mb-8">
        <a 
          href={withBase('/blog')}
          class="inline-flex items-center text-[var(--color-secondary)] hover:underline mb-6"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Powrót do bloga
        </a>

        <div class="mb-4">
          <span class="inline-block bg-[var(--color-primary)] text-[var(--color-text-dark)] px-4 py-2 rounded-full text-sm font-medium">
            {post.data.category}
          </span>
        </div>

        <h1 class="text-4xl lg:text-5xl font-bold text-[var(--color-text-dark)] mb-6">
          {post.data.title}
        </h1>

        <div class="flex items-center gap-6 text-[var(--color-text-light)] text-sm">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>{post.data.author}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <time datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('pl-PL', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>
        </div>
      </div>

      {post.data.image && (
        <div class="mb-12 rounded-2xl overflow-hidden shadow-xl">
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            class="w-full h-[400px] object-cover"
          />
        </div>
      )}

      <div class="prose prose-lg max-w-none prose-headings:font-[var(--font-heading)] prose-headings:text-[var(--color-text-dark)] prose-p:text-[var(--color-text-light)] prose-a:text-[var(--color-secondary)] prose-a:no-underline hover:prose-a:underline prose-strong:text-[var(--color-text-dark)] prose-ul:text-[var(--color-text-light)] prose-ol:text-[var(--color-text-light)]">
        <Content />
      </div>

      <div class="mt-12 p-8 bg-[var(--color-background-alt)] rounded-2xl">
        <h3 class="text-2xl font-bold text-[var(--color-text-dark)] mb-4">
          Gotowa na zmianę?
        </h3>
        <p class="text-[var(--color-text-light)] mb-6">
          Jeśli rozpoznałaś się w tym artykule, umów się na bezpłatną 15-minutową rozmowę wstępną.
          Wspólnie dobierzemy dietę i pierwszy krok współpracy.
        </p>
        <Button href="/#kontakt" size="lg">
          Umów bezpłatną konsultację
        </Button>
      </div>

      {relatedPosts.length > 0 && (
        <div class="mt-16">
          <h3 class="text-3xl font-bold text-[var(--color-text-dark)] mb-8">
            Przeczytaj także
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {relatedPosts.map((relatedPost) => (
              <a
                href={withBase(`/blog/${relatedPost.id}`)}
                class="group bg-white rounded-xl shadow-md hover:shadow-xl transition-all p-6"
              >
                <span class="inline-block bg-[var(--color-primary)] text-[var(--color-text-dark)] px-3 py-1 rounded-full text-sm font-medium mb-3">
                  {relatedPost.data.category}
                </span>
                <h4 class="text-xl font-bold text-[var(--color-text-dark)] mb-2 group-hover:text-[var(--color-secondary)] transition-colors">
                  {relatedPost.data.title}
                </h4>
                <p class="text-[var(--color-text-light)] text-sm line-clamp-2">
                  {relatedPost.data.description}
                </p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
