---
import Button from './ui/Button.astro';
import { Image } from 'astro:assets';

const credentials = [
  'Dietetyk kliniczny (licencja nr XXXX)',
  'Certyfikowany psychodietetyk',
  'Członek Polskiego Towarzystwa Dietetyki',
  'Specjalista intuicyjnego jedzenia'
];
---

<section id="o-mnie" class="py-16 lg:py-24 bg-[var(--color-background)]">
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="text-4xl lg:text-5xl font-bold text-[var(--color-text-dark)] mb-4">
        Poznajmy się
      </h2>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-2 animate-on-scroll">
        <div class="rounded-2xl overflow-hidden shadow-xl image-hover">
          <Image 
            src="/images/about/profile.jpg" 
            alt="Anna Kowalska - psychodietetyk"
            width={600}
            height={500}
            class="w-full h-[350px] md:h-[450px] lg:h-[500px] object-cover transition-transform duration-700"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="lg:col-span-3 space-y-6">
        <div class="prose prose-lg max-w-none">
          <p class="text-lg text-[var(--color-text-light)] leading-relaxed animate-on-scroll" style="animation-delay: 100ms">
            Jestem <strong class="text-[var(--color-text-dark)]">Anna Kowalska</strong>, 
            dietetykiem i psychodietetykiem.
          </p>
          
          <p class="text-lg text-[var(--color-text-light)] leading-relaxed animate-on-scroll" style="animation-delay: 200ms">
            Od 8 lat pomagam osobom, które zmęczyły się walką z jedzeniem i własnym ciałem. 
            Sama przez lata byłam w pułapce diet, więc doskonale rozumiem, przez co przechodzisz. 
            Wiem, jak frustrujące może być odzyskiwanie tych samych kilogramów i jak wyczerpujące 
            jest ciągłe myślenie o jedzeniu.
          </p>
          
          <p class="text-lg text-[var(--color-text-light)] leading-relaxed animate-on-scroll" style="animation-delay: 300ms">
            W mojej pracy łączę wiedzę naukową z empatią i holistycznym podejściem. 
            Nie liczę kalorii i nie ważę posiłków. Zamiast tego, uczymy się słuchać ciała, 
            rozpoznawać prawdziwe potrzeby i budować trwałe zdrowe nawyki.
          </p>
        </div>
        
        <div class="bg-[var(--color-background-alt)] rounded-xl p-6 space-y-3 animate-on-scroll" style="animation-delay: 400ms">
          <h3 class="text-xl font-semibold text-[var(--color-text-dark)] mb-4">
            Kwalifikacje:
          </h3>
          <ul class="space-y-2">
            {credentials.map((credential, index) => (
              <li class="flex items-center gap-3 text-[var(--color-text-light)] animate-on-scroll" style={`animation-delay: ${500 + index * 80}ms`}>
                <svg class="w-5 h-5 text-[var(--color-secondary)] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {credential}
              </li>
            ))}
          </ul>
        </div>
        
        <div class="pt-4 animate-on-scroll" style="animation-delay: 800ms">
          <Button href="#oferta" size="lg">
            Zobacz ofertę
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
