---
import Card from './ui/Card.astro';

const problems = [
  {
    icon: '🔄',
    title: 'Niekończące się diety',
    description: 'Tracisz i odzyskujesz te same kilogramy. Jo-jo stało się Twoją codziennością, a każda kolejna dieta kończy się porażką.'
  },
  {
    icon: '🧠',
    title: 'Obsesja na punkcie jedzenia',
    description: 'Każdy posiłek to stres. Ciągle myślisz o kaloriach, gramach i zakazanych produktach. Jedzenie kontroluje Twoje życie.'
  },
  {
    icon: '💭',
    title: 'Walka z własnym ciałem',
    description: 'Nie akceptujesz swojego wyglądu. Dieta jest jedynym rozwiązaniem, jakie znasz, ale nic nie działa na dłuższą metę.'
  }
];
---

<section id="problem" class="py-16 lg:py-24 bg-[var(--color-background)]">
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-[var(--color-text-dark)] mb-4">
        Czy to brzmi znajomo?
      </h2>
      <p class="text-lg text-[var(--color-text-light)] max-w-2xl mx-auto">
        Jeśli rozpoznajesz się w którejkolwiek z tych sytuacji, nie jesteś sama
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {problems.map((problem, index) => (
        <Card class="p-8 text-center">
          <div class="text-6xl mb-6">{problem.icon}</div>
          <h3 class="text-2xl font-semibold text-[var(--color-text-dark)] mb-4">
            {problem.title}
          </h3>
          <p class="text-[var(--color-text-light)] leading-relaxed">
            {problem.description}
          </p>
        </Card>
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <p class="text-lg text-[var(--color-text-dark)] font-medium">
        Te uczucia są normalne, ale nie musisz z nimi żyć.
      </p>
    </div>
  </div>
</section>
