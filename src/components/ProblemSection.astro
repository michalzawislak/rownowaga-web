---
import Card from './ui/Card.astro';
import { Image } from 'astro:assets';
import dietaJojo from '../assets/images/problem/dieta-jojo.png';
import obsesjaJedzenie from '../assets/images/problem/obsesja-jedzenie.png';
import walkaZCialem from '../assets/images/problem/walka-z-cialem.png';
import { sectionBackground, type SectionTone } from '../lib/section-tone';

interface Props {
  tone?: SectionTone;
}

const { tone = 'default' } = Astro.props;

const problems = [
  {
    image: dietaJojo,
    title: 'Diety z internetu i efekt jo-jo',
    description:
      'Kolejna dieta, kilka tygodni wyrzeczeń, spadek wagi… a później kilogramy wracają. Zamiast kolejnej diety „na chwilę” warto znaleźć sposób odżywiania, który można stosować na co dzień — bez ciągłego zaczynania od nowa.',
  },
  {
    image: obsesjaJedzenie,
    title: 'Jedzenie bez ładu',
    description:
      'Albo jesz byle co, albo w kółko to samo. Nie wiesz, co kupić, co ugotować i czy to w ogóle przybliża Cię do celu.',
  },
  {
    image: walkaZCialem,
    title: 'Brak efektów i frustracja',
    description:
      'Stosujesz dietę, starasz się, a mimo to nie widzisz efektów? Ciągłe kontrolowanie wagi, liczenie kalorii i poczucie, że „znów coś robisz nie tak”, potrafią być bardzo frustrujące.',
  },
];
---

<section id="problem" class={`py-16 lg:py-24 ${sectionBackground(tone)}`}>
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <h2 class="text-4xl lg:text-5xl font-semibold text-[var(--color-text-dark)] mb-4">
        Czy to brzmi znajomo?
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {problems.map((problem, index) => (
        <div class="animate-on-scroll" style={`animation-delay: ${index * 120}ms`}>
          <Card class="p-6 md:p-8 text-center hover-lift">
            <div class="mb-4 md:mb-6 flex justify-center">
              <Image
                src={problem.image}
                alt={problem.title}
                width={128}
                height={128}
                class="w-24 h-24 md:w-32 md:h-32 object-cover rounded-lg"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl md:text-2xl font-semibold text-[var(--color-text-dark)] mb-3 md:mb-4">
              {problem.title}
            </h3>
            <p class="text-sm md:text-base text-[var(--color-text-light)] leading-relaxed">
              {problem.description}
            </p>
          </Card>
        </div>
      ))}
    </div>
  </div>
</section>
