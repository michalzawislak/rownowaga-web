---
import Card from './ui/Card.astro';
import { Image } from 'astro:assets';
import { withBase } from '../lib/paths';

const problems = [
  {
    image: withBase('/images/problem/dieta-jojo.png'),
    title: 'Diety z internetu i efekt jo-jo',
    description: 'Kolejny gotowiec, kolejny tydzień restrykcji, potem powrót do punktu wyjścia. Brakuje planu ułożonego pod Ciebie i kogoś, kto go z Tobą utrzyma.'
  },
  {
    image: withBase('/images/problem/obsesja-jedzenie.png'),
    title: 'Jedzenie bez ładu',
    description: 'Albo jesz byle co, albo w kółko to samo. Nie wiesz, co kupić, co ugotować i czy to w ogóle przybliża Cię do celu.'
  },
  {
    image: withBase('/images/problem/walka-z-cialem.png'),
    title: 'Brak efektów i kontroli',
    description: 'Waga stoi, energia spada, a Ty nie masz jak sprawdzić, co się dzieje. Bez diety, analizy składu ciała i wizyt kontrolnych trudno iść dalej.'
  }
];
---

<section id="problem" class="py-16 lg:py-24 bg-[var(--color-background)]">
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <h2 class="text-4xl lg:text-5xl font-bold text-[var(--color-text-dark)] mb-4">
        Czy to brzmi znajomo?
      </h2>
      <p class="text-lg text-[var(--color-text-light)] max-w-2xl mx-auto">
        Jeśli rozpoznajesz się w którejkolwiek z tych sytuacji, nie jesteś sama
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {problems.map((problem, index) => (
        <div class="animate-on-scroll" style={`animation-delay: ${index * 120}ms`}>
          <Card class="p-6 md:p-8 text-center hover-lift">
            <div class="mb-4 md:mb-6 flex justify-center">
              <Image 
                src={problem.image} 
                alt={problem.title}
                width={128}
                height={128}
                class="w-24 h-24 md:w-32 md:h-32 object-cover rounded-lg"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl md:text-2xl font-semibold text-[var(--color-text-dark)] mb-3 md:mb-4">
              {problem.title}
            </h3>
            <p class="text-sm md:text-base text-[var(--color-text-light)] leading-relaxed">
              {problem.description}
            </p>
          </Card>
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center animate-on-scroll" style="animation-delay: 400ms">
      <p class="text-lg text-[var(--color-text-dark)] font-medium">
        Nie musisz układać tego sama — od tego jest gabinet.
      </p>
    </div>
  </div>
</section>
