---
import { withBase } from '../lib/paths';

const privacyHref = withBase('/polityka-prywatnosci');
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-desc"
  tabindex="-1"
  hidden
>
  <div class="cookie-consent__panel">
    <div class="cookie-consent__copy">
      <h2 id="cookie-consent-title" class="cookie-consent__title">
        Pliki cookies
      </h2>
      <p id="cookie-consent-desc" class="cookie-consent__text">
        Używamy plików cookies niezbędnych do działania strony oraz – za Twoją zgodą – cookies
        analitycznych i marketingowych (m.in. Google Ads / Analytics). Szczegóły znajdziesz w
        <a href={privacyHref}>Polityce prywatności</a>.
      </p>
    </div>

    <div class="cookie-consent__actions">
      <button
        type="button"
        class="cookie-consent__btn cookie-consent__btn--ghost"
        data-consent="reject"
      >
        Tylko niezbędne
      </button>
      <button
        type="button"
        class="cookie-consent__btn cookie-consent__btn--secondary"
        data-consent="customize"
        aria-expanded="false"
        aria-controls="cookie-consent-settings"
      >
        Ustawienia
      </button>
      <button
        type="button"
        class="cookie-consent__btn cookie-consent__btn--primary"
        data-consent="accept"
      >
        Akceptuję wszystkie
      </button>
    </div>

    <div id="cookie-consent-settings" class="cookie-consent__settings" hidden>
      <label class="cookie-consent__option">
        <input type="checkbox" checked disabled />
        <span>
          <strong>Niezbędne</strong>
          <small>Wymagane do działania strony i bezpieczeństwa.</small>
        </span>
      </label>
      <label class="cookie-consent__option">
        <input type="checkbox" id="consent-analytics" />
        <span>
          <strong>Analityczne</strong>
          <small>Pomagają mierzyć ruch i ulepszać stronę (np. Google Analytics).</small>
        </span>
      </label>
      <label class="cookie-consent__option">
        <input type="checkbox" id="consent-marketing" />
        <span>
          <strong>Marketingowe</strong>
          <small>Umożliwiają pomiar kampanii Google Ads i personalizację reklam.</small>
        </span>
      </label>
      <button
        type="button"
        class="cookie-consent__btn cookie-consent__btn--primary cookie-consent__btn--save"
        data-consent="save"
      >
        Zapisz wybór
      </button>
    </div>
  </div>
</div>

<!--
  Celowo bez <noscript><iframe src="googletagmanager.com/ns.html">: ten iframe
  wysyła żądanie do Google natychmiast, bez możliwości uzyskania zgody.
-->

<script is:inline define:vars={{ gtmId }}>
  (function () {
    const STORAGE_KEY = 'rownowaga-cookie-consent';
    const CONSENT_VERSION = 1;

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;

    function loadGtm() {
      if (!gtmId || window.__gtmLoaded) return;
      window.__gtmLoaded = true;
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
      document.head.appendChild(script);
    }

    function applyConsent(prefs) {
      const analytics = prefs.analytics ? 'granted' : 'denied';
      const marketing = prefs.marketing ? 'granted' : 'denied';

      gtag('consent', 'update', {
        analytics_storage: analytics,
        ad_storage: marketing,
        ad_user_data: marketing,
        ad_personalization: marketing,
        functionality_storage: 'granted',
        personalization_storage: analytics,
      });

      // Tryb „basic”: kontener GTM wczytujemy wyłącznie po zgodzie na
      // analitykę lub marketing. Sama odmowa nie uruchamia niczego Google.
      if (prefs.analytics || prefs.marketing) {
        loadGtm();
      }
    }

    function readStored() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || parsed.version !== CONSENT_VERSION) return null;
        return parsed;
      } catch {
        return null;
      }
    }

    function savePrefs(prefs) {
      const payload = {
        version: CONSENT_VERSION,
        analytics: !!prefs.analytics,
        marketing: !!prefs.marketing,
        updatedAt: new Date().toISOString(),
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      applyConsent(payload);
      hideBanner();
    }

    function showBanner(moveFocus) {
      const banner = document.getElementById('cookie-consent');
      if (!banner) return;
      banner.hidden = false;
      document.body.classList.add('has-cookie-banner');
      if (moveFocus) {
        // Baner jest na końcu dokumentu, więc bez przeniesienia fokusu
        // osoba korzystająca z klawiatury dotarłaby do niego na samym końcu.
        banner.focus();
      }
    }

    function hideBanner() {
      const banner = document.getElementById('cookie-consent');
      if (!banner) return;
      banner.hidden = true;
      document.body.classList.remove('has-cookie-banner');
      setSettingsOpen(false);
    }

    function setSettingsOpen(isOpen) {
      const settings = document.getElementById('cookie-consent-settings');
      const toggle = document.querySelector('[data-consent="customize"]');
      if (settings) settings.hidden = !isOpen;
      if (toggle) toggle.setAttribute('aria-expanded', String(isOpen));
    }

    function openSettings() {
      const stored = readStored();
      const analytics = document.getElementById('consent-analytics');
      const marketing = document.getElementById('consent-marketing');
      if (analytics) analytics.checked = !!(stored && stored.analytics);
      if (marketing) marketing.checked = !!(stored && stored.marketing);
      showBanner(true);
      setSettingsOpen(true);
      if (analytics) analytics.focus();
    }

    window.openCookieSettings = openSettings;

    function init() {
      const stored = readStored();
      if (stored) {
        applyConsent(stored);
      } else {
        // Przed decyzją użytkownika nie ładujemy GTM-a ani niczego od Google
        // (art. 399 Prawa komunikacji elektronicznej — zgoda uprzednia).
        showBanner(false);
      }

      const banner = document.getElementById('cookie-consent');
      if (!banner) return;

      banner.addEventListener('click', function (event) {
        const target = event.target.closest('[data-consent]');
        if (!target) return;
        const action = target.getAttribute('data-consent');

        if (action === 'accept') {
          savePrefs({ analytics: true, marketing: true });
          return;
        }
        if (action === 'reject') {
          savePrefs({ analytics: false, marketing: false });
          return;
        }
        if (action === 'customize') {
          const settings = document.getElementById('cookie-consent-settings');
          setSettingsOpen(!!settings && settings.hidden);
          return;
        }
        if (action === 'save') {
          const analyticsInput = document.getElementById('consent-analytics');
          const marketingInput = document.getElementById('consent-marketing');
          savePrefs({
            analytics: !!(analyticsInput && analyticsInput.checked),
            marketing: !!(marketingInput && marketingInput.checked),
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    padding: 1rem;
    /* Na mobile pod banerem jest CTA „Zadzwoń teraz” (3.5rem) — podnosimy baner ponad nie. */
    padding-bottom: calc(1rem + 3.5rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent__panel {
    pointer-events: auto;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.25rem;
    background: var(--color-background);
    border: 1px solid rgba(44, 62, 80, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(44, 62, 80, 0.16);
    animation: cookie-slide-up 0.35s ease-out;
  }

  .cookie-consent__copy {
    margin-bottom: 1rem;
  }

  .cookie-consent__title {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin-bottom: 0.375rem;
  }

  .cookie-consent__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-light);
  }

  .cookie-consent__text a {
    color: var(--color-secondary-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-consent__actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cookie-consent__btn {
    appearance: none;
    border: none;
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .cookie-consent__btn--primary {
    background: var(--color-secondary-text);
    color: #fff;
  }

  .cookie-consent__btn--primary:hover {
    background: var(--color-secondary-text-dark);
  }

  .cookie-consent__btn--secondary {
    background: var(--color-primary);
    color: var(--color-text-dark);
  }

  .cookie-consent__btn--ghost {
    background: transparent;
    color: var(--color-text-light);
    border: 1px solid rgba(44, 62, 80, 0.15);
  }

  .cookie-consent__btn--ghost:hover {
    color: var(--color-text-dark);
    border-color: rgba(44, 62, 80, 0.3);
  }

  .cookie-consent__settings {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(44, 62, 80, 0.08);
    display: grid;
    gap: 0.75rem;
  }

  .cookie-consent__settings[hidden] {
    display: none;
  }

  .cookie-consent__option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    cursor: pointer;
  }

  .cookie-consent__option input {
    margin-top: 0.2rem;
    accent-color: var(--color-secondary-text);
  }

  .cookie-consent__option strong {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-dark);
  }

  .cookie-consent__option small {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--color-text-light);
    line-height: 1.45;
  }

  .cookie-consent__btn--save {
    width: 100%;
  }

  @media (min-width: 768px) {
    .cookie-consent {
      padding: 1.25rem;
      padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    }

    .cookie-consent__panel {
      padding: 1.5rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1.25rem 1.5rem;
      align-items: center;
    }

    .cookie-consent__copy {
      margin-bottom: 0;
    }

    .cookie-consent__actions {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .cookie-consent__settings {
      grid-column: 1 / -1;
    }

    .cookie-consent__btn--save {
      width: auto;
      justify-self: end;
    }
  }

  /* Tylko `transform` — animowana przezroczystość chwilowo zaniża kontrast tekstu. */
  @keyframes cookie-slide-up {
    from {
      transform: translateY(12px);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent__panel {
      animation: none;
    }
  }
</style>
