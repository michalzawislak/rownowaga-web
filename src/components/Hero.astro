---
import { Picture } from 'astro:assets';
import Button from './ui/Button.astro';
import heroImage from '../assets/images/hero/hero-main.jpeg';

const checkmarks = ['Online i stacjonarnie w Szczecinie', 'Indywidualny schemat diety'];
---

<section
  id="hero"
  class="relative min-h-[80vh] md:min-h-[90vh] flex items-start lg:items-center bg-gradient-to-br from-[var(--color-background)] to-[var(--color-background-alt)] pt-24 pb-12 md:pt-28 md:pb-20 overflow-hidden"
>
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!--
        Obraz jest pierwszy w DOM, bo na mobile wyświetla się nad tekstem
        (`order-1`). Gdyby był drugi, przy wolnym łączu tekst renderowałby się
        wyżej i przeskakiwał w dół po dojściu obrazu (CLS).
      -->
      <div class="order-1 lg:order-2">
        <div class="relative mx-auto w-full max-w-md lg:max-w-xl hero-image">
          <div
            class="pointer-events-none absolute -inset-8 rounded-[2.5rem] bg-[var(--color-primary)]/70 blur-3xl"
            aria-hidden="true"
          ></div>
          <div class="relative overflow-hidden rounded-3xl shadow-[0_24px_48px_-16px_rgba(180,150,120,0.45)] ring-1 ring-[var(--color-secondary)]/15">
            <!--
              To jest element LCP: ładujemy go priorytetowo, bez animacji
              wejścia i bez JavaScriptu. `widths` odpowiadają realnym
              szerokościom w layoucie (z zapasem na ekrany 2x).
            -->
            <Picture
              src={heroImage}
              formats={['avif', 'webp']}
              widths={[360, 480, 576, 720, 960, 1152]}
              sizes="(min-width: 1024px) 576px, (min-width: 640px) 448px, calc(100vw - 2rem)"
              alt="Mosiężna waga szalkowa w równowadze: na jednej szalce warzywa, na drugiej owoce, orzechy i czekolada"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-square w-full object-cover"
            />
          </div>
        </div>
      </div>

      <div class="order-2 lg:order-1 hero-content">
        <h1 class="text-5xl lg:text-6xl font-semibold text-[var(--color-text-dark)] leading-tight mb-10 animate-fade-in-up">
          Dieta dopasowana do <span class="text-[var(--color-secondary-text)]">Twojego życia</span>
        </h1>

        <p class="text-base md:text-lg lg:text-xl text-gray-700 leading-relaxed mb-12 animate-fade-in-up animation-delay-100">
          Gabinet dietetyczny w Szczecinie. Układam indywidualną dietę na podstawie wywiadu i
          analizy składu ciała, a potem regularnie ją dopasowujemy — z przepisami, dzienniczkiem i
          aplikacją.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 mb-16 animate-fade-in-scale animation-delay-200">
          <Button href="#kontakt" size="lg">
            Bezpłatna konsultacja
          </Button>
          <Button href="#o-mnie" variant="outline" size="lg">
            Dowiedz się więcej
          </Button>
        </div>

        <!--
          Lista atutów w czystym HTML i CSS. Wcześniej była wyspą React tylko
          po to, żeby animować wejście — nie ma tu żadnej interaktywności.
        -->
        <ul class="hero-checkmarks flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 text-sm md:text-base text-[var(--color-text-light)]">
          {checkmarks.map((text, index) => (
            <li class="flex items-center gap-3" style={`animation-delay: ${500 + index * 150}ms`}>
              <svg
                class="w-5 h-5 text-[var(--color-secondary-text)] flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="leading-tight font-medium">{text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Animujemy wyłącznie `transform`. Wygaszanie przez `opacity` sprawiało,
   * że przez pierwsze 0,6 s tekst na przyciskach miał zaniżony kontrast
   * (przezroczysty element miesza się z tłem) — i mylił audyty dostępności.
   */
  @keyframes slideInUp {
    from {
      transform: translateY(30px);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes scaleIn {
    from {
      transform: scale(0.97);
    }
    to {
      transform: scale(1);
    }
  }

  .animate-fade-in-up {
    animation: slideInUp 0.6s ease-out both;
  }

  .animate-fade-in-scale {
    animation: scaleIn 0.6s ease-out both;
  }

  .animation-delay-100 {
    animation-delay: 0.1s;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .hero-checkmarks li {
    animation: slideInUp 0.5s ease-out both;
  }

  /* Sam obraz nie ma animacji wejścia — nie opóźniamy LCP. */
  .hero-image {
    animation: scaleIn 0.6s ease-out both;
    animation-delay: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up,
    .animate-fade-in-scale,
    .hero-checkmarks li,
    .hero-image {
      animation: none;
      transform: none;
    }
  }
</style>
