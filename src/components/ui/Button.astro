---
import { withBase } from '../../lib/paths';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
} = Astro.props;

const resolvedHref = href ? withBase(href) : undefined;

const classes = ['btn', `btn-${variant}`, `btn-${size}`, className].filter(Boolean).join(' ');
---

<!--
  Style przycisku są w `src/styles/global.css` (@layer components), a nie w scoped
  `<style>` tego komponentu. Scoped blok deklarowałby warstwę `components` przed
  Tailwindem, przez co reset z `@layer base` nadpisywałby padding przycisku.
  Z globalnej warstwy klasy Tailwinda przekazane przez `class` nadal wygrywają.
-->

{resolvedHref ? (
  <a href={resolvedHref} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
