---
import Card from './ui/Card.astro';
import Button from './ui/Button.astro';
import offers from '../data/offers.json';
---

<section id="oferta" class="py-16 lg:py-24 bg-[var(--color-background-alt)]">
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <h2 class="text-4xl lg:text-5xl font-bold text-[var(--color-text-dark)] mb-4">
        Jak mogę Ci pomóc?
      </h2>
      <p class="text-lg text-[var(--color-text-light)] max-w-2xl mx-auto">
        Cennik współpracy
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {offers.map((offer, index) => (
        <div class="animate-on-scroll pt-5 h-full" style={`animation-delay: ${index * 100}ms`}>
          <Card class={`p-8 relative h-full flex flex-col hover-lift ${offer.popular ? 'ring-4 ring-[var(--color-secondary)]' : ''}`}>
            {offer.popular && offer.badge && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[var(--color-secondary)] text-white px-6 py-2 rounded-full text-sm font-semibold shadow-lg whitespace-nowrap">
                {offer.badge}
              </div>
            )}
            
            <div class="text-center mb-6">
              <h3 class="text-xl md:text-2xl font-bold text-[var(--color-text-dark)] mb-2">
                {offer.name}
              </h3>
              {offer.subtitle && (
                <p class="text-sm text-[var(--color-text-light)]">
                  {offer.subtitle}
                </p>
              )}
              <div class="text-2xl md:text-3xl font-bold text-[var(--color-secondary)] mt-4">
                {offer.price}
              </div>
            </div>
            
            {offer.features.length > 0 ? (
              <ul class="space-y-4 mb-8 flex-1">
                {offer.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-[var(--color-secondary)] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-[var(--color-text-light)]">{feature}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="flex-1"></div>
            )}
            
            <Button 
              href={offer.ctaLink} 
              variant={offer.popular ? 'primary' : 'secondary'}
              class="w-full mt-auto"
            >
              {offer.ctaText}
            </Button>
          </Card>
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center animate-on-scroll" style="animation-delay: 400ms">
      <p class="text-[var(--color-text-light)]">
        Nie wiesz, od czego zacząć? 
        <a href="#kontakt" class="text-[var(--color-secondary)] font-medium hover:underline link-underline">
          Umów bezpłatną 15-minutową rozmowę
        </a>
      </p>
    </div>
  </div>
</section>
