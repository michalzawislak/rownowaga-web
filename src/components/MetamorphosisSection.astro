---
import { getImage } from 'astro:assets';
import CompareSlider from './ui/CompareSlider';
import metamorphosisData from '../data/metamorphosis.json';
import { resolveImage } from '../lib/images';
import { sectionBackground, type SectionTone } from '../lib/section-tone';

interface Props {
  tone?: SectionTone;
}

const { tone = 'default' } = Astro.props;

/**
 * Slider jest komponentem React, więc nie przyjmie `<Image>`. Optymalizujemy
 * obrazy w czasie builda przez `getImage()` i przekazujemy gotowe adresy.
 */
const optimize = async (path: string) => {
  const asset = resolveImage(path);
  // Placeholder (SVG) przepuszczamy bez zmian — nie ma czego optymalizować.
  if (asset.format === 'svg') return asset.src;

  return (await getImage({ src: asset, format: 'webp', width: 900, height: 900 })).src;
};

const items = await Promise.all(
  metamorphosisData.map(async (item) => ({
    ...item,
    beforeImage: await optimize(item.beforeImage),
    afterImage: await optimize(item.afterImage),
  })),
);
---

<section id="metamorfozy" class={`py-16 lg:py-24 ${sectionBackground(tone)}`}>
  <div class="container mx-auto px-4 md:px-8 lg:px-16 flex justify-center">
    <div class="max-w-4xl w-full">
      <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
        <h2 class="text-4xl lg:text-5xl font-semibold text-[var(--color-text-dark)] mb-4">
          Metamorfozy moich podopiecznych
        </h2>
        <p class="text-lg text-[var(--color-text-light)]">
          Historie zmian dzięki diecie i regularnej współpracy
        </p>
      </div>

      <div class="animate-on-scroll" style="animation-delay: 100ms">
        <CompareSlider items={items} client:visible />
      </div>

      <div class="mt-12 text-center animate-on-scroll" style="animation-delay: 200ms">
        <p class="text-lg text-[var(--color-text-light)]">
          Każda historia jest inna. Liczy się dieta, której da się trzymać — oraz zdrowie, energia i
          realne efekty.
        </p>
      </div>
    </div>
  </div>
</section>
