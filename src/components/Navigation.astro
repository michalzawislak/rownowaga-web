---
import Button from './ui/Button.astro';

const navItems = [
  { label: 'O mnie', href: '/#o-mnie' },
  { label: 'Oferta', href: '/#oferta' },
  { label: 'Metamorfozy', href: '/#metamorfozy' },
  { label: 'Blog', href: '/blog' },
  { label: 'Kontakt', href: '/#kontakt' },
];
---

<nav class="fixed top-0 left-0 right-0 bg-[var(--color-background)]/95 backdrop-blur-sm shadow-md z-50">
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center space-x-2">
        <div class="text-2xl font-bold font-[var(--font-heading)] text-[var(--color-secondary)]">
          Gabinet Dietetyczny
        </div>
      </a>

      <div class="hidden lg:flex items-center space-x-8">
        {navItems.map(item => (
          <a 
            href={item.href}
            class="text-[var(--color-text-dark)] hover:text-[var(--color-secondary)] transition-colors duration-200 font-medium"
          >
            {item.label}
          </a>
        ))}
        <Button href="#kontakt" size="sm">
          Umów konsultację
        </Button>
      </div>

      <button 
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-md hover:bg-[var(--color-background-alt)] transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div 
    id="mobile-menu"
    class="hidden lg:hidden bg-[var(--color-background)] border-t border-gray-200"
  >
    <div class="container mx-auto px-4 py-4 space-y-3">
      {navItems.map(item => (
        <a 
          href={item.href}
          class="block py-2 text-[var(--color-text-dark)] hover:text-[var(--color-secondary)] transition-colors duration-200 font-medium"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-2">
        <Button href="#kontakt" size="sm" class="w-full">
          Umów konsultację
        </Button>
      </div>
    </div>
  </div>
</nav>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!button?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
    }
  });

  const menuLinks = menu?.querySelectorAll('a');
  menuLinks?.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
