---
import Button from './ui/Button.astro';
import business from '../data/business.json';
import features from '../data/features.json';
import { withBase } from '../lib/paths';

type NavItem = {
  label: string;
  href: string;
  feature?: keyof typeof features;
  section?: string;
  path?: string;
};

const allNavItems: NavItem[] = [
  { label: 'O mnie', href: withBase('/#o-mnie'), section: 'o-mnie' },
  { label: 'Oferta', href: withBase('/#oferta'), section: 'oferta' },
  {
    label: 'Metamorfozy',
    href: withBase('/#metamorfozy'),
    feature: 'metamorphosis',
    section: 'metamorfozy',
  },
  { label: 'Blog', href: withBase('/blog'), feature: 'blog', path: withBase('/blog') },
  { label: 'Kontakt', href: withBase('/#kontakt'), section: 'kontakt' },
];

const navItems = allNavItems.filter((item) => item.feature === undefined || features[item.feature]);

const phoneHref = `tel:${business.telephone.replace(/\s/g, '')}`;
const addressLine = `${business.address.streetAddress}, ${business.address.postalCode} ${business.address.addressLocality}`;

/**
 * Godziny w formie, którą skrypt czyta bez znajomości struktury `business.json`:
 * numer dnia tygodnia zgodny z `Date.getDay()` (niedziela = 0).
 */
const dayNumbers: Record<string, number> = {
  Sunday: 0,
  Monday: 1,
  Tuesday: 2,
  Wednesday: 3,
  Thursday: 4,
  Friday: 5,
  Saturday: 6,
};

const openingHoursData = business.openingHours.map((entry) => ({
  day: dayNumbers[entry.dayOfWeek],
  name: entry.day,
  opens: entry.opens,
  closes: entry.closes,
}));

const socialLinks = [
  {
    href: business.sameAs.find((url) => url.includes('instagram.com')),
    label: 'Instagram',
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.8 3.8 0 01-1.38-.9 3.8 3.8 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 5.18a4.66 4.66 0 100 9.32 4.66 4.66 0 000-9.32zm0 7.69a3.03 3.03 0 110-6.06 3.03 3.03 0 010 6.06zm5.94-7.87a1.09 1.09 0 11-2.18 0 1.09 1.09 0 012.18 0z',
  },
  {
    href: business.sameAs.find((url) => url.includes('facebook.com')),
    label: 'Facebook',
    path: 'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z',
  },
].filter((link): link is { href: string; label: string; path: string } => Boolean(link.href));
---

<nav
  aria-label="Menu główne"
  class="fixed top-0 left-0 right-0 bg-[var(--color-background)]/95 backdrop-blur-sm shadow-md z-50"
>
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="flex items-center justify-between h-20">
      <a href={withBase('/')} class="flex items-center space-x-2">
        <div class="text-xl md:text-2xl font-bold font-[var(--font-heading)] text-[var(--color-secondary-text)]">
          {business.shortName}
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-[var(--color-text-dark)] hover:text-[var(--color-secondary-text)] transition-colors duration-200 font-medium whitespace-nowrap"
            data-nav-section={item.section}
            data-nav-path={item.path}
          >
            {item.label}
          </a>
        ))}
        <Button href="/#kontakt" size="sm" class="ml-2">
          Umów konsultację
        </Button>
      </div>

      <!--
        Jeden przycisk przełącza panel i sam zmienia się w krzyżyk — obie kreski
        obracają się z pozycji hamburgera, więc nie podmieniamy ikon w JS.
      -->
      <button
        id="mobile-menu-button"
        type="button"
        class="menu-toggle lg:hidden"
        aria-label="Otwórz menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-toggle__bars" aria-hidden="true">
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
          <span class="menu-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>
</nav>

<!--
  Panel zajmuje cały ekran pod paskiem nawigacji. Poza odnośnikami niesie to,
  po co klient najczęściej sięga na telefonie: numer, dzisiejszy status
  otwarcia i adres. Dzięki temu menu jest wizytówką, a nie spisem treści.

  Celowo leży poza paskiem nawigacji: pasek ma `backdrop-blur`, a filtr tła
  tworzy nowy układ odniesienia dla elementów `position: fixed`. Zagnieżdżony
  panel liczyłby swoje `bottom: 0` względem paska o wysokości 5rem i miałby
  zerową wysokość.
-->
<nav id="mobile-menu" class="mobile-menu hidden lg:hidden" aria-label="Menu mobilne">
  <div class="mobile-menu__inner container mx-auto px-4">
    <ul class="mobile-menu__list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-mobile-link"
            data-nav-section={item.section}
            data-nav-path={item.path}
          >
            <span>{item.label}</span>
            <svg
              class="nav-mobile-link__arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <div class="mobile-menu__contact">
      <a href={phoneHref} class="mobile-menu__phone">
        <span class="mobile-menu__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
          </svg>
        </span>
        <span class="mobile-menu__phone-text">
          <span class="mobile-menu__phone-number">{business.telephone}</span>
          <!--
              Domyślnie neutralny opis — skrypt podmienia go na dzisiejszy status
              otwarcia. Bez JavaScriptu zostaje sensowne zdanie zamiast pustki.
            -->
          <span
            class="mobile-menu__status"
            id="menu-opening-status"
            data-hours={JSON.stringify(openingHoursData)}
          >
            Zadzwoń i umów wizytę
          </span>
        </span>
      </a>

      <a href={business.hasMap} class="mobile-menu__row" target="_blank" rel="noopener noreferrer">
        <span class="mobile-menu__icon mobile-menu__icon--muted" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
            <path d="M12 2a7 7 0 00-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1112 6.5a2.5 2.5 0 010 5z" />
          </svg>
        </span>
        <span class="mobile-menu__row-text">
          <span>{addressLine}</span>
          <span class="mobile-menu__status">Zobacz na mapie</span>
        </span>
      </a>

      {socialLinks.length > 0 && (
        <ul class="mobile-menu__social">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={link.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )}

      <!--
        Opakowanie daje uchwyt do animacji wejścia: style z tego pliku nie
        sięgają do wnętrza komponentu Button.
      -->
      <div class="mobile-menu__cta">
        <Button href="/#kontakt" class="w-full">
          Umów konsultację
        </Button>
      </div>
    </div>
  </div>
</nav>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(
    '[data-nav-section], [data-nav-path]',
  );
  const headerOffset = 80;

  /* ---------------------------------------------------------------- menu --- */

  /**
   * Przy otwartym panelu blokujemy przewijanie tła. `position: fixed` na `body`
   * gubi pozycję przewinięcia, więc zapamiętujemy ją i przywracamy przy
   * zamknięciu — inaczej strona skakałaby na górę po każdym zamknięciu menu.
   */
  let savedScrollY = 0;

  function lockScroll(): void {
    savedScrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${savedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.classList.add('menu-open');
  }

  function unlockScroll(): void {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.classList.remove('menu-open');
    /*
     * `behavior: 'instant'` jest tu konieczne: `html` ma `scroll-behavior:
     * smooth`, więc zwykłe `scrollTo` animowałoby powrót z samej góry strony —
     * użytkownik widziałby przewijanie przez pół strony po zamknięciu menu.
     */
    window.scrollTo({ top: savedScrollY, left: 0, behavior: 'instant' });
  }

  function focusableItems(): HTMLElement[] {
    if (!menu) return [];
    return [...menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
  }

  function setMenuOpen(isOpen: boolean): void {
    const wasOpen = !menu?.classList.contains('hidden');
    if (isOpen === wasOpen) return;

    menu?.classList.toggle('hidden', !isOpen);
    button?.setAttribute('aria-expanded', String(isOpen));
    button?.setAttribute('aria-label', isOpen ? 'Zamknij menu' : 'Otwórz menu');

    if (isOpen) {
      lockScroll();
    } else {
      unlockScroll();
    }
  }

  button?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? false);
  });

  document.addEventListener('keydown', (e) => {
    if (menu?.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      setMenuOpen(false);
      button?.focus();
      return;
    }

    /*
     * Pułapka fokusu: przy otwartym panelu Tab krąży między przyciskiem
     * przełączającym a zawartością menu. Bez tego fokus uciekał na stronę pod
     * spodem, której użytkownik czytnika ekranu w ogóle wtedy nie widzi.
     */
    if (e.key !== 'Tab' || !button) return;

    const stops = [button, ...focusableItems()];
    if (stops.length === 0) return;

    const first = stops[0];
    const last = stops[stops.length - 1];
    const active = document.activeElement;

    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenuOpen(false);
    });
  });

  /* ------------------------------------------------------ godziny otwarcia --- */

  type OpeningHours = {
    day: number;
    name: string;
    opens: string;
    closes: string;
  };

  /** Mianownik z `business.json` nie pasuje do zdania „otwarte w…". */
  const dayInLocative: Record<string, string> = {
    poniedziałek: 'w poniedziałek',
    wtorek: 'we wtorek',
    środa: 'w środę',
    czwartek: 'w czwartek',
    piątek: 'w piątek',
    sobota: 'w sobotę',
    niedziela: 'w niedzielę',
  };

  function toMinutes(time: string): number {
    const [hours, minutes] = time.split(':').map(Number);
    return hours * 60 + minutes;
  }

  /**
   * Czas liczymy w strefie gabinetu, nie przeglądarki — ktoś przeglądający
   * stronę z innej strefy dostałby inaczej błędną informację o otwarciu.
   */
  function warsawNow(): { day: number; minutes: number } {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Europe/Warsaw',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date());

    const lookup = (type: string) => parts.find((part) => part.type === type)?.value ?? '0';
    const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    return {
      day: Math.max(0, days.indexOf(lookup('weekday'))),
      minutes: (Number(lookup('hour')) % 24) * 60 + Number(lookup('minute')),
    };
  }

  function nextOpening(
    hours: OpeningHours[],
    fromDay: number,
  ): { entry: OpeningHours; inDays: number } | null {
    for (let offset = 1; offset <= 7; offset += 1) {
      const day = (fromDay + offset) % 7;
      const entry = hours.find((item) => item.day === day);
      if (entry) return { entry, inDays: offset };
    }
    return null;
  }

  function openingStatus(hours: OpeningHours[]): string | null {
    if (hours.length === 0) return null;

    const now = warsawNow();
    const today = hours.find((entry) => entry.day === now.day);

    if (today && now.minutes < toMinutes(today.opens)) {
      return `Dziś otwarte od ${today.opens}`;
    }

    if (today && now.minutes < toMinutes(today.closes)) {
      return `Teraz otwarte · do ${today.closes}`;
    }

    const next = nextOpening(hours, now.day);
    if (!next) return null;

    const when = next.inDays === 1 ? 'jutro' : (dayInLocative[next.entry.name] ?? next.entry.name);
    return `Zamknięte · otwarte ${when} od ${next.entry.opens}`;
  }

  function renderOpeningStatus(): void {
    const target = document.getElementById('menu-opening-status');
    const raw = target?.dataset.hours;
    if (!target || !raw) return;

    try {
      const status = openingStatus(JSON.parse(raw) as OpeningHours[]);
      if (!status) return;

      target.textContent = status;
      target.classList.add('is-resolved');
      target.classList.toggle('is-open', status.startsWith('Teraz otwarte'));
    } catch {
      /* Zostaje domyślna treść z HTML-a. */
    }
  }

  renderOpeningStatus();

  /* ------------------------------------------------------- aktywna sekcja --- */

  function pathMatches(navPath: string): boolean {
    const current = window.location.pathname.replace(/\/$/, '') || '/';
    const target = navPath.replace(/\/$/, '') || '/';
    return current === target || current.startsWith(`${target}/`);
  }

  function setActiveSection(sectionId: string | null) {
    navLinks.forEach((link) => {
      const sectionActive = sectionId !== null && link.dataset.navSection === sectionId;
      const pathActive =
        sectionId === null && !!link.dataset.navPath && pathMatches(link.dataset.navPath);
      const isActive = sectionActive || pathActive;

      link.classList.toggle('is-active', isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  const sections = [...navLinks]
    .map((link) => link.dataset.navSection)
    .filter((id, index, all): id is string => Boolean(id) && all.indexOf(id) === index)
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  function updateActiveNav() {
    if (sections.length === 0) {
      setActiveSection(null);
      return;
    }

    const spyLine = Math.max(headerOffset + 24, Math.round(window.innerHeight * 0.4));
    let current: string | null = null;

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= spyLine) {
        current = section.id;
      }
    }

    setActiveSection(current);
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (link.dataset.navSection) {
        setActiveSection(link.dataset.navSection);
      }
    });
  });

  let ticking = false;

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateActiveNav();
      ticking = false;
    });
  };

  document.addEventListener('scroll', onScroll, { passive: true, capture: true });

  const observer = new IntersectionObserver(onScroll, {
    rootMargin: `-${headerOffset}px 0px -40% 0px`,
    threshold: [0, 0.25, 0.5, 0.75, 1],
  });

  sections.forEach((section) => observer.observe(section));
  updateActiveNav();
</script>

<style>
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 2px;
    background-color: var(--color-secondary-text);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .nav-link.is-active,
  .nav-mobile-link.is-active {
    color: var(--color-secondary-text);
  }

  /* ------------------------------------------------------------ hamburger --- */

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.5rem;
    border-radius: 0.5rem;
    color: var(--color-text-dark);
    transition: background-color 0.2s ease;
  }

  .menu-toggle:hover {
    background-color: var(--color-background-alt);
  }

  .menu-toggle__bars {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 1rem;
  }

  .menu-toggle__bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    transition:
      transform 0.25s ease,
      opacity 0.15s ease;
  }

  .menu-toggle__bar:nth-child(1) {
    top: 0;
  }

  .menu-toggle__bar:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }

  .menu-toggle__bar:nth-child(3) {
    bottom: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ----------------------------------------------------------- panel menu --- */

  .mobile-menu {
    position: fixed;
    inset: 5rem 0 0;
    z-index: 45;
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--color-background);
  }

  .mobile-menu.hidden {
    display: none;
  }

  .mobile-menu__inner {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1.25rem;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
  }

  /* Marginesy `auto` dzielą wolną przestrzeń po równo nad i pod listą, więc przy trzech pozycjach panel nie wygląda na w połowie pusty. */
  .mobile-menu__list {
    border-top: 1px solid rgba(44, 62, 80, 0.08);
    margin-top: auto;
    margin-bottom: auto;
  }

  .nav-mobile-link {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(44, 62, 80, 0.08);
    color: var(--color-text-dark);
    font-family: var(--font-heading);
    font-size: 1.75rem;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link:focus-visible {
    color: var(--color-secondary-text);
  }

  .nav-mobile-link__arrow {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-secondary-text);
    opacity: 0.55;
  }

  /* --------------------------------------------------------- blok kontaktu --- */

  /* Blok kontaktu zostaje przy dolnej krawędzi, bliżej kciuka. */
  .mobile-menu__contact {
    display: grid;
    gap: 0.75rem;
  }

  .mobile-menu__phone,
  .mobile-menu__row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 0.875rem;
    background-color: var(--color-background-alt);
    color: var(--color-text-dark);
    transition: background-color 0.2s ease;
  }

  .mobile-menu__phone:hover,
  .mobile-menu__row:hover {
    background-color: var(--color-primary);
  }

  .mobile-menu__icon {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background-color: var(--color-secondary-text);
    color: #fff;
  }

  .mobile-menu__icon--muted {
    background-color: var(--color-primary-dark);
    color: var(--color-text-dark);
  }

  .mobile-menu__icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .mobile-menu__phone-text,
  .mobile-menu__row-text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .mobile-menu__phone-number {
