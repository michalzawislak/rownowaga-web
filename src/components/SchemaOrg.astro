---
import business from '../data/business.json';
import { withBase } from '../lib/paths';

const siteOrigin = (Astro.site?.href ?? business.url).replace(/\/$/, '');
const siteRoot = `${siteOrigin}${import.meta.env.BASE_URL}`.replace(/\/$/, '') || siteOrigin;
const toAbsolute = (path: string) => `${siteOrigin}${withBase(path)}`;

const imageUrl = toAbsolute(business.image);
const specialistImageUrl = toAbsolute(business.specialist.image);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'Dietitian'],
      '@id': `${siteRoot}/#business`,
      name: business.name,
      alternateName: business.alternateName,
      description: business.description,
      url: siteRoot,
      telephone: business.telephone,
      email: business.email,
      image: imageUrl,
      priceRange: business.priceRange,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.streetAddress,
        addressLocality: business.address.addressLocality,
        postalCode: business.address.postalCode,
        addressCountry: business.address.addressCountry,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.geo.latitude,
        longitude: business.geo.longitude,
      },
      openingHoursSpecification: business.openingHours.map((hours) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: hours.dayOfWeek,
        opens: hours.opens,
        closes: hours.closes,
      })),
      sameAs: business.sameAs,
      employee: { '@id': `${siteRoot}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteRoot}/#person`,
      name: business.specialist.name,
      jobTitle: business.specialist.jobTitle,
      image: specialistImageUrl,
      worksFor: { '@id': `${siteRoot}/#business` },
      url: siteRoot,
      sameAs: business.sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}/#website`,
      url: siteRoot,
      name: business.alternateName,
      description: business.description,
      publisher: { '@id': `${siteRoot}/#business` },
      inLanguage: 'pl-PL',
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
