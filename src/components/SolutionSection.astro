---
import Button from './ui/Button.astro';

const benefits = [
  'Intuicyjnym jedzeniem i słuchaniem ciała',
  'Uwalnianiem się od diet mentalności',
  'Budowaniem pozytywnej relacji z jedzeniem',
  'Akceptacją ciała i self-compassion',
  'Znajdowaniem równowagi bez restrykcji'
];
---

<section id="solution" class="py-16 lg:py-24 bg-[var(--color-background-alt)]">
  <div class="container mx-auto px-4 md:px-8 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="order-2 lg:order-1">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img 
            src="/images/solution/mindful-eating.jpg" 
            alt="Intuicyjne jedzenie - spokojne podejście do posiłków"
            class="w-full h-[400px] lg:h-[500px] object-cover"
          />
        </div>
      </div>
      
      <div class="order-1 lg:order-2 space-y-6">
        <h2 class="text-4xl lg:text-5xl font-bold text-[var(--color-text-dark)]">
          Jest <span class="text-[var(--color-secondary)]">inna droga</span>
        </h2>
        
        <p class="text-lg text-[var(--color-text-light)] leading-relaxed">
          Psychodietetyka to podejście, które łączy wiedzę o żywieniu z psychologią. 
          Zamiast kolejnej diety, pracujemy nad trwałą zmianą Twojej relacji z jedzeniem.
        </p>
        
        <div class="space-y-4">
          <p class="text-[var(--color-text-dark)] font-medium">
            Zamiast kolejnej diety, pracujemy nad:
          </p>
          <ul class="space-y-3">
            {benefits.map(benefit => (
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[var(--color-secondary)] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-[var(--color-text-light)]">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="pt-4">
          <Button href="#o-mnie" variant="secondary">
            Zobacz jak pracuję
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
